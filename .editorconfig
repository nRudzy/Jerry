root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,svg}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.ps1]
charset = utf-8-bom

[src/Jerry.App/Assets/Fonts/*-OFL.txt]
# Upstream licenses retain their exact original bytes.
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
